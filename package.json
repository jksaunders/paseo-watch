{
  "name": "paseo-watch",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "bin": {
    "paseo-watch": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts daemon",
    "daemon": "node src/main.ts daemon",
    "once": "node src/main.ts once",
    "status": "node src/main.ts status",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome check --write",
    "lint": "biome check"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
